<?xml version="1.0" encoding="UTF-8"?>
<rn3:connector version='1.5' xmlns:rn0='java:sap/standard' xmlns:rn1='http://schemas.xmlsoap.org/soap/encoding/' xmlns:rn2='http://www.w3.org/2001/XMLSchema' xmlns:rn3='http://java.sun.com/xml/ns/j2ee'>
  <rn3:display-name>sample_ra</rn3:display-name>
  <rn3:vendor-name>sap.com</rn3:vendor-name>
  <rn3:eis-type>XI AF Sample Resource Adapter</rn3:eis-type>
  <rn3:resourceadapter-version>1.4</rn3:resourceadapter-version>
  <rn3:resourceadapter>
    <rn3:outbound-resourceadapter>
      <rn3:connection-definition>
        <rn3:managedconnectionfactory-class>com.sap.aii.af.sample.adapter.ra.SPIManagedConnectionFactory</rn3:managedconnectionfactory-class>
        <rn3:config-property>
          <rn3:description></rn3:description>
          <rn3:config-property-name>addressMode</rn3:config-property-name>
          <rn3:config-property-type>java.lang.String</rn3:config-property-type>
          <rn3:config-property-value>CPA</rn3:config-property-value>
