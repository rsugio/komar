<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log-configuration SYSTEM "log-configuration.dtd">

<log-configuration>

  <log-formatters>
    <log-formatter name="trc" type="TraceFormatter"  pattern="%d %l [%t] %10s %m"/>
    <log-formatter name="audit_log_formatter" type="TraceFormatter"  pattern="%30d %m"/>
  </log-formatters>

  <log-destinations>
    <log-destination name="trcInfoWarning" type="FileLog" pattern="./log/services/com.sap.portal.prt.sapj2ee/infoAndWarning.default.trc"
                     effective-severity="ALL" count="5" limit="10000000"/>
    <log-destination name="readable_trcInfoWarning" type="FileLog" pattern="./log/services/com.sap.portal.prt.sapj2ee/infoAndWarning.readable.trc"
                     effective-severity="ALL" count="5" limit="10000000">
       <formatter-ref name="trc"/>
    </log-destination>
    <log-destination name="portalTrace" type="FileLog" pattern="./log/applications/portal/portal.trc"
                     effective-severity="ALL" count="5" limit="10000000"/>
    <log-destination name="trcError" type="FileLog" pattern="./log/services/com.sap.portal.prt.sapj2ee/error.default.trc"
                     effective-severity="ALL" count="5" limit="10000000"/>
    <log-destination name="readable_trcError" type="FileLog" pattern="./log/services/com.sap.portal.prt.sapj2ee/error.readable.trc"
                     effective-severity="ALL" count="5" limit="10000000">
       <formatter-ref name="trc"/>
    </log-destination>
  </log-destinations>

  <log-controllers>
    <log-controller name="com.sap.portal.prt.sapj2ee.infoWarning" effective-severity="ERROR">
      <associated-destinations>
        <destination-ref name="trcInfoWarning" association-type="LOG"/>
        <destination-ref name="readable_trcInfoWarning" association-type="LOG"/>
      </associated-destinations>
    </log-controller>
    <log-controller name="com.sap.portal.prt.sapj2ee.error" effective-severity="ERROR">
      <associated-destinations>
        <destination-ref name="trcError" association-type="LOG"/>
        <destination-ref name="readable_trcError" association-type="LOG"/>
      </associated-destinations>
    </log-controller>

    <log-controller name="com.sap.portal.pcd" effective-severity="ERROR">
      <associated-destinations>
        <destination-ref name="portalTrace" association-type="LOG"/>
