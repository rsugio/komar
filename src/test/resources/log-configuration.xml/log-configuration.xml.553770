<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log-configuration SYSTEM "log-configuration.dtd">
<log-configuration>
	<!-- ============================================================== -->
	<log-formatters>
		<log-formatter 
			name="trc" 
			type="ListFormatter"/>
	</log-formatters>
	<log-destinations>
		<!-- library trace -->
		<log-destination 
			count="5" 
			effective-severity="DEBUG" 
			limit="10000000" 
			name="trc" 
			pattern="./log/applications/bizc/default.trc" 
			type="FileLog"/>
	</log-destinations>
	<!-- ============================================================== -->
	<log-controllers>
		<!-- log controller for project com.sap.bizc -->
		<log-controller 
			effective-severity="ERROR" 
			name="com.sap.bizc">
			<associated-destinations>
				<destination-ref 
					association-type="LOG" 
					name="trc"/>
			</associated-destinations>
		</log-controller>
		<!-- log controller for XML Data Binding -->
	</log-controllers>
</log-configuration>

