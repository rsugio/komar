<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log-configuration SYSTEM "log-configuration.dtd">
<log-configuration>
	<log-formatters>
		<!-- This formatter produces human readable messages. -->
		<log-formatter 
			name="frm" 
			pattern="%26d %150l [%t] %10s: %m" 
			type="TraceFormatter"/>
	</log-formatters>
	<log-destinations>
		<!-- Destination for Trace Information of the com.sap.aii.security service -->
		<log-destination 
			count="5" 
			effective-severity="DEBUG" 
			limit="1000000" 
			name="trc" 
			pattern="./log/services/com.sap.aii.security/default.trc" 
			type="FileLog">
			<formatter-ref 
				name="frm"/>
		</log-destination>
		<!-- Destination for Trace Information of the com.sap.aii.security service -->
	</log-destinations>
	<log-controllers>
		<!-- Tracing Location com.sap.aii.security -->
		<log-controller 
			effective-severity="ERROR" 
			maximum-severity="FATAL" 
			minimum-severity="DEBUG" 
			name="com.sap.aii.security">
			<associated-destinations>
				<destination-ref 
					association-type="LOG" 
					name="trc"/>
			</associated-destinations>
		</log-controller>
	</log-controllers>
</log-configuration>

