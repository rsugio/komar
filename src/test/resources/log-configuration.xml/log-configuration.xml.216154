<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log-configuration SYSTEM "log-configuration.dtd">
<log-configuration>
    <log-formatters>
        <log-formatter
            name="readable"
            pattern="%24d [%t] %-70l %8s: %m"
            type="TraceFormatter"/>
    </log-formatters>
    <log-destinations>
        <log-destination
            count="10"
            effective-severity="ALL"
            limit="2000000"
            name="readable_trc"
            pattern="./log/libraries/tc/di/dtrclient/protocol/plb/readable%g.trc"
            type="FileLog">
            <formatter-ref name="readable"/>
        </log-destination>
    </log-destinations>
    <log-controllers>
        <log-controller
            effective-severity="ERROR"
            name="com.sap.dtr.client.lib.protocol">
            <associated-destinations>
                <destination-ref
                    association-type="LOG"
                    name="readable_trc"/>
            </associated-destinations>
        </log-controller>
    </log-controllers>
</log-configuration>

