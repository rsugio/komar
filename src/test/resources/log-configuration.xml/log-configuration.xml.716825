<!DOCTYPE log-configuration SYSTEM "log-configuration.dtd">

<log-configuration>

  <log-destinations>

	<!-- Traces -->
	<log-destination name="MessageDisplayToolTrace"
		type="FileLog"
		pattern="./log/applications/com.sap.xi/mdt.trc" 
		count="5" 
		limit="5000000">
	</log-destination>

  </log-destinations>

  <log-controllers>

    <!-- Traces -->
    <log-controller name="com.sap.aii.mdt" effective-severity="ERROR">
      <associated-destinations>
        <destination-ref name="MessageDisplayToolTrace" association-type="LOG"/>
      </associated-destinations>
    </log-controller>

  </log-controllers>

</log-configuration>

