<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log-configuration SYSTEM "log-configuration.dtd">
<log-configuration>
	<log-destinations>
		<log-destination 
			count="10" 
			effective-severity="WARNING" 
			limit="1000000" 
			name="BIJIFDestination" 
			pattern="./log/applications/BI/UDI.log" 
			type="FileLog">
		</log-destination>
                <log-destination 
                        name="trc" 
                        type="FileLog" 
                        pattern="./log/applications/BI/UDI_default.trc"
                        effective-severity="ALL" count="5" limit="10000000"/>
	</log-destinations>
	<log-controllers>
		<log-controller 
			effective-severity="WARNING" 
			maximum-severity="FATAL" 
			minimum-severity="DEBUG" 
			name="/Applications/BI/UDI">
                   <associated-destinations>
                     <destination-ref name="BIJIFDestination" association-type="LOG"/>
                   </associated-destinations>
		</log-controller>
                <log-controller 
                        name="com.sap.ip.bi.sdk" 
			maximum-severity="FATAL" 
			minimum-severity="DEBUG" 
                        effective-severity="WARNING">
                   <associated-destinations>
                     <destination-ref name="trc" association-type="LOG"/>
                   </associated-destinations>
                </log-controller>
	</log-controllers>
</log-configuration>

