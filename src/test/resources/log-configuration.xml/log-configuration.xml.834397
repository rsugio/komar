<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log-configuration SYSTEM "log-configuration.dtd">
<log-configuration>
	<log-formatters>
		<!-- This formatter produces human readable messages. -->
		<log-formatter name="trc" pattern="%26d %150l [%t] %10s: %m" type="TraceFormatter"/>
	</log-formatters>
	
	<log-destinations>
		<!-- Destination for Trace Information of this service com.sap.aii.adapter.file.svc -->
		<log-destination count="3" effective-severity="DEBUG" limit="1000000" name="FILEtrc" 
			pattern="./log/services/com.sap.aii.adapter.file.svc/default.trc" type="FileLog">
			<formatter-ref name="trc"/>
		</log-destination>
	</log-destinations>

	<log-controllers>
		<!-- Trace Location com.sap.aii.adapter.file -->
		<log-controller name="com.sap.aii.adapter.file" effective-severity="ERROR">
			<associated-destinations>
				<destination-ref association-type="LOG" name="FILEtrc"/>
			</associated-destinations>
		</log-controller>

		<!-- Trace Location com.sap.aii.adapter.file.ftp -->
		<log-controller name="com.sap.aii.adapter.file.ftp" effective-severity="ERROR">
			<associated-destinations>
				<destination-ref association-type="LOG" name="FILEtrc"/>
			</associated-destinations>
		</log-controller>

		<!-- Trace Location com.sap.aii.adapter.file.configuration -->
		<log-controller name="com.sap.aii.adapter.file.configuration" effective-severity="ERROR">
			<associated-destinations>
				<destination-ref association-type="LOG" name="FILEtrc"/>
			</associated-destinations>
		</log-controller>

		<!-- Logging Category: none, we use the default XILog -->
	</log-controllers>
</log-configuration>

<!-- from D:\distr\SAP_PO\PO75sp32/SAPXIAF32_0-80000737.zip/com.sap.aii.adapter.file.svc.sda/log-configuration.xml -->