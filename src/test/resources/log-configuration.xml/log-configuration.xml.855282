<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE log-configuration SYSTEM "log-configuration.dtd">

<log-configuration>

	<log-formatters>
		<!-- This formatter produces human readable messages. -->
		<log-formatter name="trc" pattern="%26d %150l [%t] %10s: %m"
			type="TraceFormatter" />
	</log-formatters>

	<log-destinations>
		<!-- Destination for Trace Information of this ra com.sap.aii.adapter.sftp.ra.rar -->
		<log-destination count="1" effective-severity="INFO"
			limit="5000000" name="sftp.trc"
			pattern="./log/applications/com.sap.aii.adapter.sftp.ra.rar/jca_sftp.trc"
			type="FileLog">
			<formatter-ref name="trc" />
		</log-destination>
	</log-destinations>

	<log-controllers>
		<!-- Trace Location com.sap.aii.adapter.sftp.ra.rar -->
		<log-controller name="com.sap.aii.adapter.sftp.ra.rar"
			effective-severity="WARNING">
			<associated-destinations>
				<destination-ref association-type="LOG" name="sftp.trc" />
			</associated-destinations>

		</log-controller>
		<!-- Logging Category: none, use the default XILog -->

	</log-controllers>
</log-configuration>

