<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log-configuration SYSTEM "log-configuration.dtd">
<log-configuration>
  <log-formatters>
	<!-- This formatter produces human readable messages. -->
	<log-formatter name="trc" pattern="%26d %150l [%t] %10s: %m" type="TraceFormatter"/>
  </log-formatters>
  <log-destinations>
	<!-- Traces -->
	<log-destination name="JPRTrace"
		type="FileLog"
		pattern="./log/libraries/com.sap.aii.proxy/default.trc" 
		count="5" 
		limit="2000000">
		<formatter-ref name="trc"/>
	</log-destination>
  </log-destinations>
  <log-controllers>
	<!-- Traces -->
	<log-controller name="com.sap.aii.proxy.xiruntime.ack" effective-severity="DEBUG">
		<associated-destinations>
			<destination-ref name="JPRTrace" association-type="LOG"/>
		</associated-destinations>
	</log-controller>
	<log-controller name="com.sap.aii.proxy.xiruntime.core" effective-severity="DEBUG">
		<associated-destinations>
			<destination-ref name="JPRTrace" association-type="LOG"/>
		</associated-destinations>
	</log-controller>
	<log-controller name="com.sap.aii.proxy.xiruntime.test" effective-severity="DEBUG">
		<associated-destinations>
			<destination-ref name="JPRTrace" association-type="LOG"/>
		</associated-destinations>
	</log-controller>
	<log-controller name="com.sap.aii.proxy.xiruntime.web" effective-severity="DEBUG">
		<associated-destinations>
			<destination-ref name="JPRTrace" association-type="LOG"/>
		</associated-destinations>
	</log-controller>
  </log-controllers>
</log-configuration>

<!-- from D:\distr\SAP_PO\PO75sp32/SAPXIAF32_0-80000737.zip/com.sap.aii.proxy.svc.sda/log-configuration.xml -->