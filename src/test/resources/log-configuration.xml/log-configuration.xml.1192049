<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log-configuration SYSTEM "log-configuration.dtd">
<log-configuration>
	<log-formatters/>
	<log-destinations>
		<log-destination 
			count="5" 
			effective-severity="INFO" 
			limit="8000000" 
			name="common" 
			pattern="./log/applications/sap.com/com.sap.slm/common.log" 
			type="FileLog">
			<anonymous-formatter 
				type="ListFormatter"/>
		</log-destination>
	</log-destinations>
	<log-controllers>
		<log-controller 
			bundle-name="com.sap.slm.util.configuration.messages" 
			effective-severity="INFO" 
			maximum-severity="INFO" 
			minimum-severity="FATAL" 
			name="/Applications/SLM">
			<associated-destinations>
				<destination-ref 
					association-type="LOG" 
					name="common"/>
			</associated-destinations>
		</log-controller>
	</log-controllers>
</log-configuration>

