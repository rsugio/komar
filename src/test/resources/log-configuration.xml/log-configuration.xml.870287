<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log-configuration SYSTEM "log-configuration.dtd">
<log-configuration>

	<log-formatters>
		<!-- This formatter produces human readable messages. -->
		<log-formatter name="trc" pattern="%26d %150l [%t] %10s: %m" type="TraceFormatter"/>
	</log-formatters>
	
	<log-destinations>
		<!-- Destination for Trace Information of this application com.sap.aii.af.app -->
		<log-destination count="3" effective-severity="DEBUG" limit="1000000" name="AFAppTrc" 
			pattern="./log/applications/com.sap.aii.af.app/default.trc" type="FileLog">
			<formatter-ref name="trc"/>
		</log-destination>
	</log-destinations>

	<log-controllers>
		<!-- Trace Location com.sap.aii.af.mp.impl -->
		<log-controller name="com.sap.aii.af.app" effective-severity="ERROR">
			<associated-destinations>
				<destination-ref association-type="LOG" name="AFAppTrc"/>
			</associated-destinations>
		</log-controller>
		<!-- Logging Category: none, we use the default XILog -->
	</log-controllers>

</log-configuration>
<!-- from D:\distr\SAP_PO\PO75sp32/SAPXIAF32_0-80000737.zip/com.sap.aii.af.app.sda/log-configuration.xml -->