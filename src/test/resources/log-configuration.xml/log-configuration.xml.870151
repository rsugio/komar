<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log-configuration SYSTEM "log-configuration.dtd">
<log-configuration>

	<log-formatters>
		<!-- This formatter produces human readable messages. -->
		<log-formatter name="trc" pattern="%26d %150l [%t] %10s: %m" type="TraceFormatter"/>
	</log-formatters>
	
	<log-destinations>
		<!-- Destination for Trace Information of this service com.sap.aii.adapter.xi -->
		<log-destination count="3" effective-severity="DEBUG" limit="1000000" name="XItrc" 
			pattern="./log/services/com.sap.aii.adapter.xi/default.trc" type="FileLog">
			<formatter-ref name="trc"/>
		</log-destination>
	</log-destinations>
	
	<log-controllers>
		<!-- Tracing Location  -->
		<log-controller effective-severity="ERROR" name="com.sap.aii.adapter.xi">
			<associated-destinations>
				<destination-ref association-type="LOG" name="XItrc"/>
			</associated-destinations>
		</log-controller>	
	</log-controllers>
	
</log-configuration>

<!-- from D:\distr\SAP_PO\PO75sp32/SAPXIAF32_0-80000737.zip/com.sap.aii.adapter.xi.svc.sda/log-configuration.xml -->