<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log-configuration SYSTEM "log-configuration.dtd">
<log-configuration>

	<log-formatters>
		<!-- This formatter produces human readable messages. -->
		<log-formatter name="trc" pattern="%26d %150l [%t] %10s: %m" type="TraceFormatter"/>
	</log-formatters>
	
	<log-destinations>
		<log-destination count="3" effective-severity="DEBUG" limit="1000000" name="JMStrc" 
			pattern="./log/applications/com.sap.aii.adapter.jms/default.trc" type="FileLog">
			<formatter-ref name="trc"/>
		</log-destination>
	</log-destinations>

	<log-controllers>
		<log-controller name="com.sap.aii.adapter.jms" effective-severity="ERROR">
			<associated-destinations>
				<destination-ref association-type="LOG" name="JMStrc"/>
			</associated-destinations>
		</log-controller>
	</log-controllers>

</log-configuration>

<!-- from D:\distr\SAP_PO\PO75sp32/SAPXIAF32_0-80000737.zip/com.sap.aii.adapter.jms.app.sda/com.sap.aii.adapter.jms.ejb.jar/log-configuration.xml -->