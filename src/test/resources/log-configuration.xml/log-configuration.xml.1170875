<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE log-configuration SYSTEM 'log-configuration.dtd'>

  <log-configuration>
    <log-formatters>
      <log-formatter name="SlTraceFile" pattern="%24d %-40l [%t] %7s: %m" type="TraceFormatter">
      </log-formatter>
    </log-formatters>
    <log-destinations>
      <log-destination count="2" limit="10000000" name="slTrace" pattern="./log/libraries/com.sap.sl.util/SlTrace.log" type="FileLog">
        <formatter-ref name="SlTraceFile">
        </formatter-ref>
      </log-destination>
      <log-destination count="" limit="" name="slLog" pattern="./log/libraries/com.sap.sl.util/SlLogging.log" type="FileLog">
        <anonymous-formatter type="TraceFormatter">
        </anonymous-formatter>
      </log-destination>
    </log-destinations>
    <log-controllers>

      <log-controller effective-severity="ERROR" name="/Applications/SL">
        <associated-destinations>
          <destination-ref association-type="LOG" name="slLog">
          </destination-ref>
        </associated-destinations>
      </log-controller>

      <log-controller effective-severity="ERROR" name="com.sap.sl">
        <associated-destinations>
          <destination-ref association-type="LOG" name="slTrace">
          </destination-ref>
        </associated-destinations>
      </log-controller>

	<log-controller name="/Applications/SL/UTIL" effective-severity="ERROR" minimum-severity="ALL" maximum-severity="FATAL"/>
		
    </log-controllers>
  </log-configuration>


<!-- from D:\distr\SAP_PO\PO75sp32/SERVERCORE32_0-80000485.zip/tc~SL~utility.sda/log-configuration.xml -->