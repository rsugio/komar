<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log-configuration SYSTEM "log-configuration.dtd">

<log-configuration>
	<log-destinations>
		<log-destination name="trc" type="FileLog" pattern="./log/applications/sap.com/com.sap.lm.webadmin.mainframe/mainframe.trc" effective-severity="ALL" count="5" limit="10000000"/>
	</log-destinations>
	<log-controllers>
		<log-controller name="com.sap.lm.webadmin.mainframe" effective-severity="ERROR">
			<associated-destinations>
				<destination-ref name="trc" association-type="LOG"/>
			</associated-destinations>
		</log-controller>		
	</log-controllers>
</log-configuration>

