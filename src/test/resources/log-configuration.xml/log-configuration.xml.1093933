<!DOCTYPE log-configuration SYSTEM "log-configuration.dtd">

<log-configuration>

  <log-destinations>

	<!-- Traces -->
	<log-destination name="RuntimeWorkbenchTrace"
		type="FileLog"
		pattern="./log/applications/com.sap.xi/rwb.trc" 
		count="5" 
		limit="5000000">
	</log-destination>

  </log-destinations>

  <log-controllers>

	<!-- Traces -->
    <log-controller name="com.sap.aii.rwb" effective-severity="ERROR">
      <associated-destinations>
        <destination-ref name="RuntimeWorkbenchTrace" association-type="LOG"/>
      </associated-destinations>
    </log-controller>

  </log-controllers>

</log-configuration>

