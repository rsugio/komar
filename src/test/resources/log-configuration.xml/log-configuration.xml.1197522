
<!DOCTYPE log-configuration SYSTEM "log-configuration.dtd">

<log-configuration>

  <log-formatters>
      <log-formatter name="fmt" type="TraceFormatter" pattern="%d %12t%10s%m"/>
  </log-formatters>

  <log-destinations>
    <log-destination name='problem_trc' type='FileLog' pattern="./log/applications/sap.com/com.sap.uddi/problem.trc" effective-severity='INFO' count="5" limit='800000'>
      <formatter-ref name="fmt"/>
    </log-destination>
    <log-destination name='user_trc' type='FileLog' pattern="./log/applications/sap.com/com.sap.uddi/user_error.trc" effective-severity='INFO' count="5" limit='800000'>
      <formatter-ref name="fmt"/>
    </log-destination>
    <log-destination name='uddi_trc' type='FileLog' pattern="./log/applications/sap.com/com.sap.uddi/uddi.trc" effective-severity='INFO' count="5" limit='800000'>
      <formatter-ref name="fmt"/>
    </log-destination>
    <log-destination name='soap_trc' type='FileLog' pattern="./log/applications/sap.com/com.sap.uddi/soap_msg.trc" effective-severity='INFO' count="5" limit='800000'>
      <formatter-ref name="fmt"/>
    </log-destination>
    <log-destination name='repl_trc' type='FileLog' pattern="./log/applications/sap.com/com.sap.uddi/repl.trc" effective-severity='INFO' count="5" limit='800000'>
      <formatter-ref name="fmt"/>
    </log-destination>
    <log-destination name='dal_trc' type='FileLog' pattern="./log/applications/sap.com/com.sap.uddi/dal.trc" effective-severity='INFO' count="5" limit='800000'>
      <formatter-ref name="fmt"/>
    </log-destination>
    <log-destination name='sqlmon_trc' type='FileLog' pattern="./log/applications/sap.com/com.sap.uddi/sqlmon.trc" effective-severity='FATAL' count="5" limit='800000'>
      <formatter-ref name="fmt"/>
    </log-destination>
    <log-destination name='generic_trc' type='FileLog' pattern="./log/applications/sap.com/com.sap.uddi/generic.trc" effective-severity='INFO' count="5" limit='800000'>
      <formatter-ref name="fmt"/>
    </log-destination>
    <log-destination name='debug_trc' type='FileLog' pattern="./log/applications/sap.com/com.sap.uddi/debug.trc" effective-severity='FATAL' count="5" limit='800000'>
    </log-destination>
  </log-destinations>

  <log-controllers>
    <log-controller name="com.sap.uddi.problem" effective-severity="INFO">
      <associated-destinations>
        <destination-ref name="problem_trc" association-type="LOG"/>
      </associated-destinations>
    </log-controller>
    <log-controller name="com.sap.uddi.user" effective-severity="INFO">
      <associated-destinations>
        <destination-ref name="user_trc" association-type="LOG"/>
      </associated-destinations>
    </log-controller>
    <log-controller name="com.sap.uddi.uddi" effective-severity="INFO">
      <associated-destinations>
        <destination-ref name="uddi_trc" association-type="LOG"/>
      </associated-destinations>
    </log-controller>
    <log-controller name="com.sap.uddi.soap" effective-severity="INFO">
      <associated-destinations>
        <destination-ref name="soap_trc" association-type="LOG"/>
      </associated-destinations>
    </log-controller>
    <log-controller name="com.sap.uddi.repl" effective-severity="INFO">
      <associated-destinations>
        <destination-ref name="repl_trc" association-type="LOG"/>
      </associated-destinations>
    </log-controller>
    <log-controller name="com.sap.uddi.dal" effective-severity="WARNING">
      <associated-destinations>
        <destination-ref name="dal_trc" association-type="LOG"/>
      </associated-destinations>
    </log-controller>
    <log-controller name="com.sap.uddi.sqlmon" effective-severity="FATAL">
      <associated-destinations>
        <destination-ref name="sqlmon_trc" association-type="LOG"/>
      </associated-destinations>
    </log-controller>
    <log-controller name="com.sap.uddi.generic" effective-severity="INFO">
      <associated-destinations>
        <destination-ref name="generic_trc" association-type="LOG"/>
      </associated-destinations>
    </log-controller>
    <log-controller name="com.sap.uddi.debug" effective-severity="INFO">
      <associated-destinations>
        <destination-ref name="debug_trc" association-type="LOG"/>
      </associated-destinations>
    </log-controller>
  </log-controllers>
</log-configuration>

<!-- from D:\distr\SAP_PO\PO75sp32/UDDI32_0-80000499.zip/tc~uddi.sda/log-configuration.xml -->