<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log-configuration SYSTEM "log-configuration.dtd">
<log-configuration>
	<log-formatters>
		<log-formatter 
			name="traceformatter" 
			pattern="%24d %-80l [%t] %s: %m" 
			type="TraceFormatter"/>
		<log-formatter 
			name="listformatter" 
			type="ListFormatter"/>
		<log-formatter 
			name="xmlformatter" 
			type="XMLFormatter"/>
	</log-formatters>
	<log-destinations>
		<log-destination 
			count="10" 
			effective-severity="ALL" 
			limit="10485760" 
			name="dscore" 
			pattern="./log/services/developmentserver/core/default.trc" 
			type="FileLog">
			<formatter-ref 
				name="listformatter"/>
		</log-destination>
		<log-destination 
			count="10" 
			effective-severity="ALL" 
			limit="10485760" 
			name="dscategory" 
			pattern="./log/services/developmentserver/core/Logs.log" 
			type="FileLog">
			<formatter-ref 
				name="traceformatter"/>
		</log-destination>
		<log-destination 
			count="10" 
			effective-severity="ALL" 
			limit="10485760" 
			name="dsenvironment" 
			pattern="./log/services/developmentserver/metamodel/default.trc" 
			type="FileLog">
			<formatter-ref 
				name="listformatter"/>
		</log-destination>
		<log-destination 
			count="10" 
			effective-severity="ALL" 
			limit="10485760" 
			name="dsrepository" 
			pattern="./log/services/developmentserver/repository/default.trc" 
			type="FileLog">
			<formatter-ref 
				name="listformatter"/>
		</log-destination>
		<log-destination 
			count="10" 
			effective-severity="ALL" 
			limit="10485760" 
			name="dsbuild" 
			pattern="./log/services/developmentserver/build/default.trc" 
			type="FileLog">
			<formatter-ref 
				name="listformatter"/>
		</log-destination>
	</log-destinations>
	<log-controllers>
		<log-controller 
			effective-severity="ERROR" 
			maximum-severity="NONE" 
			name="com.sap.ds.core">
			<associated-destinations>
				<destination-ref 
					association-type="LOG" 
					name="dscore"/>
			</associated-destinations>
		</log-controller>
		<log-controller 
			effective-severity="ERROR" 
			maximum-severity="NONE" 
			name="/System/Server/VCServer">
			<associated-destinations>
				<destination-ref 
					association-type="LOG" 
					name="dscategory"/>
			</associated-destinations>
		</log-controller>
		<log-controller 
			effective-severity="ERROR" 
			maximum-severity="NONE" 
			name="com.sap.ds.env.metamodel">
			<associated-destinations>
				<destination-ref 
					association-type="LOG" 
					name="dsenvironment"/>
			</associated-destinations>
		</log-controller>
		<log-controller 
			effective-severity="ERROR" 
			maximum-severity="NONE" 
			name="com.sap.ds.nwdi">
			<associated-destinations>
				<destination-ref 
					association-type="LOG" 
					name="dsrepository"/>
			</associated-destinations>
		</log-controller>
		<log-controller 
			effective-severity="ERROR" 
			maximum-severity="NONE" 
			name="com.sap.ds.env.repository">
			<associated-destinations>
				<destination-ref 
					association-type="LOG" 
					name="dsrepository"/>
			</associated-destinations>
		</log-controller>
		<log-controller 
			effective-severity="ERROR" 
			maximum-severity="NONE" 
			name="com.sap.ds.env.model.build">
			<associated-destinations>
				<destination-ref 
					association-type="LOG" 
					name="dsbuild"/>
			</associated-destinations>
		</log-controller>
	</log-controllers>
</log-configuration>

<!-- from D:\distr\SAP_PO\PO75sp32/VCFRAMEWORK32_0-80000727.zip/vc_ds_service.sda/log-configuration.xml -->