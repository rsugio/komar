<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log-configuration SYSTEM "log-configuration.dtd">
<log-configuration>

	<log-formatters>
		<!-- This formatter produces human readable messages. -->
		<log-formatter name="trc" pattern="%26d %150l [%t] %10s: %m" type="TraceFormatter"/>
	</log-formatters>
	
	<log-destinations>
		<!-- Destination for Trace Information of this service com.sap.aii.af.cpa -->
		<log-destination count="3" effective-severity="DEBUG" limit="1000000" name="BRMSREPtrc" 
			pattern="./log/services/com.sap.brms.repository/default.trc" type="FileLog">
			<formatter-ref name="trc"/>
		</log-destination>
	</log-destinations>

	<log-controllers>
		<!-- Trace Location com.sap.glx.core -->
		<log-controller name="com.sap.brms.repository" effective-severity="ERROR">
			<associated-destinations>
				<destination-ref association-type="LOG" name="BRMSREPtrc"/>
			</associated-destinations>
		</log-controller>
		<!-- Logging Category: none, we use the default XILog -->
	</log-controllers>

</log-configuration>

