<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log-configuration SYSTEM "log-configuration.dtd">
<log-configuration>

	<log-formatters>
		<!-- This formatter produces human readable messages. -->
		<log-formatter name="trc" pattern="%26d %150l [%t] %10s: %m" type="TraceFormatter"/>
	</log-formatters>
	
	<log-destinations>
		<!-- Destination for Trace Information of this library com.sap.aii.af.sdk.xi -->
		<log-destination count="3" effective-severity="DEBUG" limit="1000000" name="MSGtrc" 
			pattern="./log/libraries/com.sap.aii.af.sdk.xi/default.trc" type="FileLog">
			<formatter-ref name="trc"/>
		</log-destination>
	</log-destinations>

	<log-controllers>
		<!-- Trace Location com.sap.aii.af.sdk.xi -->
		<log-controller name="com.sap.aii.af.sdk.xi" effective-severity="ERROR">
			<associated-destinations>
				<destination-ref association-type="LOG" name="MSGtrc"/>
			</associated-destinations>
		</log-controller>
	</log-controllers>
	
</log-configuration>

