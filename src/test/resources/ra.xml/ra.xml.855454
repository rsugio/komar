<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE connector PUBLIC '-//Sun Microsystems, Inc.//DTD Connector 1.0//EN' 'http://java.sun.com/dtd/connector_1_0.dtd'>
<connector>
	<display-name>XISOAPAdapter RA</display-name>
	<vendor-name>sap.com</vendor-name>
	<spec-version>1.0</spec-version>
	<eis-type>XI SOAP Adapter RA</eis-type>
	<version>1.0.0</version>
	<resourceadapter>
		<config-property>
		        <description>Remove Namespaces</description>
		        <config-property-name>RemoveNS</config-property-name>
		        <config-property-type>java.lang.Boolean</config-property-type>
		        <config-property-value>false</config-property-value>
		</config-property> 
		<config-property>
			<description>CDATA Length</description>
		    <config-property-name>CDATA_Length</config-property-name>
		    <config-property-type>java.lang.Integer</config-property-type>
		    <config-property-value>0</config-property-value>
		</config-property> 
		<managedconnectionfactory-class>
			com.sap.aii.adapter.soap.ra.SPIManagedConnectionFactory
		</managedconnectionfactory-class>
		<connectionfactory-interface>
			javax.resource.cci.ConnectionFactory
		</connectionfactory-interface>
		<connectionfactory-impl-class>
			com.sap.aii.adapter.soap.ra.CCIConnectionFactory
		</connectionfactory-impl-class>
		<connection-interface>
			javax.resource.cci.Connection
		</connection-interface>
		<connection-impl-class>
        	com.sap.aii.adapter.soap.ra.CCIConnection
		</connection-impl-class>
		<transaction-support>
			NoTransaction
		</transaction-support>
		<authentication-mechanism>
			<authentication-mechanism-type>
				BasicPassword
			</authentication-mechanism-type>
			<credential-interface>
				javax.resource.spi.security.PasswordCredential
			</credential-interface>
		</authentication-mechanism>
		<reauthentication-support>
			false
		</reauthentication-support>
	</resourceadapter>
</connector>

