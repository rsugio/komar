<?xml version="1.0" encoding="UTF-8"?>
<connector>
	<display-name>WebServices</display-name>
	<vendor-name>SAP</vendor-name>
	<spec-version>1.5</spec-version>
	<eis-type>WebServices</eis-type>
	<version>3.9</version>
	<resourceadapter>
		<managedconnectionfactory-class>com.sap.portal.connector.webservices.connection.WSManagedConnectionFactory</managedconnectionfactory-class>
		<connectionfactory-interface>javax.resource.cci.ConnectionFactory</connectionfactory-interface>
		<connectionfactory-impl-class>com.sap.portal.connector.webservices.connection.CCIConnectionFactory</connectionfactory-impl-class>
		<connection-interface>javax.resource.cci.Connection</connection-interface>
		<connection-impl-class>com.sap.portal.connector.webservices.connection.CCIConnection</connection-impl-class>
		<transaction-support>NoTransaction</transaction-support>
		<config-property>
			<description>Determines which runtime will execute the web service. Valid options are ESP (default) and SAAJ.</description>
			<config-property-name>RuntimeMode</config-property-name>
			<config-property-type>java.lang.String</config-property-type>
			<config-property-value>ESP</config-property-value>
		</config-property>
		<config-property>
			<description>Determines if cache is used by default.</description>
			<config-property-name>UseCacheByDefault</config-property-name>
			<config-property-type>java.lang.String</config-property-type>
			<config-property-value>true</config-property-value>
		</config-property>		
		<authentication-mechanism>
			<authentication-mechanism-type>BasicPassword</authentication-mechanism-type>
			<credential-interface>javax.resource.spi.security.PasswordCredential</credential-interface>
		</authentication-mechanism>
		<reauthentication-support>false</reauthentication-support>
	</resourceadapter>
</connector>

