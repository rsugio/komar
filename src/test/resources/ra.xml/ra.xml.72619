<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE connector PUBLIC '-//Sun Microsystems, Inc.//DTD Connector 1.0//EN' 'http://java.sun.com/dtd/connector_1_0.dtd'>

<connector>
  <display-name>BI_XMLA_CONNECTOR</display-name>
  <vendor-name>SAP AG</vendor-name>
  <spec-version>1.0</spec-version>
  <eis-type>XMLA-compliant OLAP data sources</eis-type>
  <description>SAP Business Intelligence Java Connector for XMLA (XML for Analysis)</description>
  <version>1.0</version>
  <resourceadapter>
     <managedconnectionfactory-class>
		com.sap.ip.bi.sdk.dac.connector.xmla.XmlaManagedConnectionFactory
     </managedconnectionfactory-class>

     <connectionfactory-interface>
      	javax.resource.cci.ConnectionFactory
     </connectionfactory-interface>

     <connectionfactory-impl-class>
		com.sap.ip.bi.sdk.dac.connector.xmla.XmlaConnectionFactory
     </connectionfactory-impl-class>

     <connection-interface>
      	 javax.resource.cci.Connection
     </connection-interface>

     <connection-impl-class>
		com.sap.ip.bi.sdk.dac.connector.xmla.XmlaConnection
     </connection-impl-class>

     <transaction-support>NoTransaction</transaction-support>
       <config-property>
            <config-property-name>UserName</config-property-name>
            <config-property-type>java.lang.String</config-property-type>
            <config-property-value></config-property-value>
	    <description>User name</description>
        </config-property>
        <config-property>
            <config-property-name>Password</config-property-name>
            <config-property-type>java.lang.String</config-property-type>
            <config-property-value></config-property-value>
	    <description>Password</description>
        </config-property>
        <config-property>
            <config-property-name>Language</config-property-name>
            <config-property-type>java.lang.String</config-property-type>
            <config-property-value></config-property-value>
	    <description>Language</description>
        </config-property>
        <config-property>
            <config-property-name>DataSource</config-property-name>
            <config-property-type>java.lang.String</config-property-type>
            <config-property-value></config-property-value>
	    <description>Data Source Info</description>
        </config-property>
        <config-property>
            <config-property-name>URL</config-property-name>
            <config-property-type>java.lang.String</config-property-type>
            <config-property-value></config-property-value>
	    <description>example: http://[host]:[port]/sap/bw/xml/soap/xmla</description>
        </config-property>
        <config-property>
            <config-property-name>Statefulness</config-property-name>
            <config-property-type>java.lang.String</config-property-type>
            <config-property-value></config-property-value>
	    <description>Statefulness support</description>
        </config-property>
        <config-property>
            <config-property-name>Logonmethod</config-property-name>
            <config-property-type>java.lang.String</config-property-type>
            <config-property-value></config-property-value>
	    <description>Logon method</description>
        </config-property>
        <config-property>
            <config-property-name>Timeout</config-property-name>
            <config-property-type>java.lang.String</config-property-type>
            <config-property-value></config-property-value>
	    <description>Max time to wait for connection (in ms)</description>
        </config-property>
        <authentication-mechanism>
            <authentication-mechanism-type>SAPAssertionTicket</authentication-mechanism-type>
            <credential-interface>javax.resource.spi.security.GenericCredential</credential-interface>
        </authentication-mechanism>
        <reauthentication-support>false</reauthentication-support>

   </resourceadapter>
</connector>


