<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="AdapterTypeMetaData">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="GuiHandlerClassName"/>
        <xs:element ref="Type"/>
        <xs:element ref="GuiLabels"/>
        <xs:element ref="Outbound"/>
        <xs:element ref="Inbound"/>
        <xs:choice maxOccurs="unbounded">
          <xs:element ref="Attribute"/>
          <xs:element ref="AttributeTable"/>
          <xs:element ref="DynamicAttributes"/>
        </xs:choice>
        <xs:element maxOccurs="unbounded" ref="TabDefinition"/>
      </xs:sequence>
      <xs:attribute name="version" use="required" type="xs:integer"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="GuiHandlerClassName">
    <xs:complexType/>
  </xs:element>
  <xs:element name="Outbound">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="TransportProtocol"/>
        <xs:element maxOccurs="unbounded" ref="MessageProtocol"/>
        <xs:element ref="GlobalChannelAttributes"/>
        <xs:element ref="GlobalSecurityAttributes"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Inbound">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="TransportProtocol"/>
        <xs:element maxOccurs="unbounded" ref="MessageProtocol"/>
        <xs:element ref="GlobalChannelAttributes"/>
        <xs:element ref="GlobalSecurityAttributes"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Attribute">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Name"/>
        <xs:element minOccurs="0" ref="Usage"/>
        <xs:choice maxOccurs="unbounded">
          <xs:element ref="Flag"/>
          <xs:element ref="GuiLabels"/>
          <xs:element ref="DataType"/>
          <xs:element ref="Default"/>
          <xs:element ref="FixedValue"/>
          <xs:element ref="HelpService"/>
          <xs:element ref="Length"/>
        </xs:choice>
      </xs:sequence>
      <xs:attribute name="isPassword" type="xs:boolean"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="DataType" type="xs:string"/>
  <xs:element name="Default" type="xs:string"/>
  <xs:element name="FixedValue">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="value"/>
        <xs:element ref="GuiLabels"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="value" type="xs:string"/>
  <xs:element name="HelpService">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="HelpServiceName"/>
        <xs:element ref="HelpServiceQueryAttributes"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="HelpServiceName" type="xs:NCName"/>
  <xs:element name="HelpServiceQueryAttributes">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="HelpServiceQueryAttribute"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="HelpServiceQueryAttribute">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Name"/>
        <xs:element ref="value"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <!--xs:element name="Value" type="xs:string"/-->
  <xs:element name="Length" type="xs:integer"/>
  <xs:element name="AttributeTable">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Name"/>
        <xs:element ref="Usage"/>
        <xs:element minOccurs="0" ref="Flag"/>
        <xs:choice>
          <xs:element ref="GuiLabels"/>
          <xs:element ref="Label"/>
        </xs:choice>
        <xs:element maxOccurs="unbounded" ref="AttributeReference"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="DynamicAttributes">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="AttributeReference"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="TabDefinition">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="GuiLabels"/>
      </xs:sequence>
      <xs:attribute name="id" use="required" type="xs:NCName"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="Type" type="xs:NCName"/>
  <xs:element name="GuiLabels">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="Label"/>
      </xs:sequence>
      <xs:attribute name="guid"/>
      <xs:attribute name="resourceId"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="TransportProtocol">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Name"/>
        <xs:element ref="Version"/>
        <xs:element ref="GuiLabels"/>
        <xs:element ref="ValidMessageProtocols"/>
        <xs:element ref="ChannelAttributes"/>
        <xs:element ref="SecurityAttributes"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ValidMessageProtocols">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="ProtocolIdentifier"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ProtocolIdentifier">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Name"/>
        <xs:element ref="Version"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="MessageProtocol">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Name"/>
        <xs:element ref="Version"/>
        <xs:element ref="GuiLabels"/>
        <xs:element minOccurs="0" ref="ChannelAttributes"/>
        <xs:element ref="SecurityAttributes"/>
        <xs:element ref="ModuleProcessorAttributes"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ModuleProcessorAttributes">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="ModuleSequence"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ModuleSequence">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="ModuleSequenceItem"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ModuleSequenceItem">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Name"/>
        <xs:element ref="Type"/>
        <xs:element ref="Key"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Key" type="xs:integer"/>
  <xs:element name="GlobalChannelAttributes">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Tab"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="GlobalSecurityAttributes">
    <xs:complexType/>
  </xs:element>
  <xs:element name="Name" type="xs:NCName"/>
  <xs:element name="Usage" type="xs:NCName"/>
  <xs:element name="Flag" type="xs:NCName"/>
  <xs:element name="AttributeReference">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="ReferenceName"/>
        <xs:choice minOccurs="0">
          <xs:element ref="EditCondition"/>
          <xs:element ref="NotCondition"/>
          <xs:element ref="OrCondition"/>
          <xs:element ref="AndCondition"/>
        </xs:choice>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ReferenceName" type="xs:NCName"/>
  <xs:element name="AndCondition">
    <xs:complexType>
      <xs:sequence>
        <xs:choice maxOccurs="unbounded">
          <xs:element ref="EditCondition"/>
          <xs:element ref="OrCondition"/>
        </xs:choice>
        <xs:element minOccurs="0" ref="NotCondition"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Label">
    <xs:complexType mixed="true">
      <xs:attribute name="language" use="required" type="xs:NCName"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="Version" type="xs:string"/>
  <xs:element name="ChannelAttributes">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="Tab"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="SecurityAttributes">
    <xs:complexType/>
  </xs:element>
  <xs:element name="Tab">
    <xs:complexType>
      <xs:choice maxOccurs="unbounded">
        <xs:element ref="AttributeReference"/>
        <xs:element ref="AttributeGroup"/>
      </xs:choice>
      <xs:attribute name="id" use="required" type="xs:NCName"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="AttributeGroup">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="Name"/>
        <xs:element ref="GuiLabels"/>
        <xs:element maxOccurs="unbounded" ref="AttributeReference"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="EditCondition">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="AttributeName"/>
        <xs:element maxOccurs="unbounded" ref="AttributeValue"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="AttributeName" type="xs:NCName"/>
  <xs:element name="AttributeValue" type="xs:string"/>
  <xs:element name="NotCondition">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="EditCondition"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="OrCondition">
    <xs:complexType>
      <xs:sequence>
        <xs:element maxOccurs="unbounded" ref="EditCondition"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>

