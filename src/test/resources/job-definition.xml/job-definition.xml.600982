<job-definitions>
    <job-definition name="LogJobBean" description="extracts latest logs for ETD">
    </job-definition>
    <job-definition name="ContextJobBean" description="extracts system context and user context for ETD (if context has changed)">
    </job-definition>
    <job-definition name="TestLogJobBean" description="creates one test log for ETD">
    </job-definition>
    <job-definition name="TestContextJobBean" description="extracts system context and one user context for ETD">
    </job-definition>
</job-definitions>

