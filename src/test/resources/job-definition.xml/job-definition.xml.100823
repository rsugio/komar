<?xml version="1.0" encoding="UTF-8"?>
<job-definitions>
	<job-definition name="GalaxyCoreJob" description="Galaxy Timer"
		retention-period="1">
		<job-definition-parameter name="UserData"
			data-type="String" direction="IN" />
		<job-definition-parameter name="RetryCount"
			data-type="Integer" direction="IN" />
	</job-definition>
	<job-definition name="GalaxyTimerJob" description="Galaxy Chronometer tick handling"
		retention-period="1">
		<job-definition-parameter name="UserData"
			data-type="String" direction="IN" />
		<job-definition-parameter name="RetryCount"
			data-type="Integer" direction="IN" />
		<job-definition-parameter name="Origin"
			data-type="String" nullable="Y" direction="IN" />
	</job-definition>
	<job-definition name="GalaxyRecoveryJob"
		description="Recovers failed Galaxy job executions" retention-period="1" />
</job-definitions>

