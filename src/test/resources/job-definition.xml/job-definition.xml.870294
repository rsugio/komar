<?xml version="1.0" encoding="UTF-8"?>
<job-definitions>
	<job-definition name="SuspendResumeAFWJob" description="Sets suspend/resume mode for PI Adapter Engine" retention-period="30">
		<job-definition-parameter 	name="channelsSuspended" 
									description="If true sets the PI Adapter Engine in suspend mode, if false set the PI Adapter Engine in resume mode"
									data-type="Boolean"
									direction="IN"
									data-default="false"
									nullable="Y"
									group="Lifetime Settings" />
	</job-definition>

	<job-definition name="SyncStatisticsDataJob" description="Sync Message Overview data with status of PI messages from the database" retention-period="30">
		<job-definition-parameter 	name="syncLastNMinutes" 
									description="Number of minutes to sync. System will use the global default value from parameter profile.runtime.sync.statistics.lastMinutes of service XPI Service AF Core, if this parameter is 0 or less." 
									data-type="Long"
									direction="IN"
									data-default="0"
									nullable="Y"
									group="Lifetime Settings" />
	</job-definition>

	<job-definition name="DeleteUnusedProfileHashDataJob" description="Delete unused Message Overview scenario data" retention-period="30">
	</job-definition>
</job-definitions>
