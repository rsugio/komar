<job-definitions>
	<job-definition name="CleanJob" retention-period="1" description="This job removes outdated job scheduler data. By default it only handles jobs in status COMPLETED. The job parameters can be used to change that behavior.">
		<job-parameter name="HandleStateUnknown" direction="in" data_type="boolean" data_default="false" nullable="Y" description="Jobs in status UNKNOWN are not removed by the clean job. When set to true, jobs in status UNKNOWN will be handled like jobs in status COMPLETED and removed according to their retention period."/>
		<job-parameter name="HandleStateStarting" direction="in" data_type="boolean" data_default="false" nullable="Y" description="Jobs in status STARTING are not removed by the clean job. When set to true, jobs in status STARTING will be handled like jobs in status COMPLETED and removed according to their retention period."/>
		<job-parameter name="HandleStateError" direction="in" data_type="boolean" data_default="false" nullable="Y" description="Jobs in status ERROR are not removed by the clean job. When set to true, jobs in status ERROR will be handled like jobs in status COMPLETED and removed according their retention period."/>
		<job-parameter name="HandleStateCancelled" direction="in" data_type="boolean" data_default="false" nullable="Y" description="Jobs in status CANCELLED are not removed by the clean job. When set to true, jobs in status CANCELLED will be handled like jobs in status COMPLETED and removed according their retention period."/>
		<job-parameter name="HandleAnyRetentionPeriod" direction="in" data_type="boolean" data_default="false" nullable="Y" description="Jobs with eligible statuses won't be removed if retention period has not expired.If set to true the jobs will be removed.Note that this parameter doesn't influence jobs with infinite retention period."/>
		<job-parameter name="HandleInfiniteRetentionPeriod" direction="in" data_type="boolean" data_default="false" nullable="Y" description="Jobs with statuses eligible for remove won't be removed if retention period is infinite. When set to true these jobs will be removed."/>
		<job-parameter name="RemoveTasksEndedBefore" direction="in" data_type="Date" data_default="" nullable="Y" description="By default CleanJob removes tasks not in status ACTIVE or HOLD which have finished at least before 30 days.Set this parameter to remove tasks with appropriate statuses ended before the specified Date."/>
	</job-definition>
</job-definitions>


