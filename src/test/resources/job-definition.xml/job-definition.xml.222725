<job-definitions>
    <job-definition name="EcmStoreCleanupJob" description="Searches for and removes inconsistent entries from the EcmStore persistence">
    <job-definition-parameter name="TestMode" data-type="Boolean" data-default="true" 
    	description="When set to true, nothing will be changed on the database. Inconsistencies are only reported but not fixed."
    	display="Y" direction="IN"/>
    </job-definition>
</job-definitions>
