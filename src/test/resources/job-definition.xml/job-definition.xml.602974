<?xml version="1.0" encoding="UTF-8"?>
<job-definitions>
	<job-definition description="This job deletes the cached data from WebDav" name="DeleteWebDavCacheJob" retention-period="30">
		<job-definition-parameter name="retentionInDays" 
								direction="in" 
								data_type="Integer" 
								nullable="N" 
								data-default="30" 
								description="The number of days after which the files in cache are deleted."/>
	</job-definition>
</job-definitions>

