<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE connector-j2ee-engine SYSTEM 'connector-j2ee-engine.dtd'>
<connector-j2ee-engine>
	<jndi-name>SAPFactory</jndi-name>
	<pool-params>
		<max-connections-number>100</max-connections-number>
		<max-time-to-wait-connection>60</max-time-to-wait-connection>
		<expiration-control>
			<connection-lifetime>3600</connection-lifetime>
			<run-cleanup-thread>5</run-cleanup-thread>
		</expiration-control>
	</pool-params>
</connector-j2ee-engine>
