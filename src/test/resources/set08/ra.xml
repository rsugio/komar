<?xml version="1.0" encoding="UTF-8"?>
<connector id="Connector_ID" version="1.5" xmlns="http://java.sun.com/xml/ns/j2ee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/connector_1_5.xsd">
	<description>ODataAdapter</description>
	<display-name>com.sap.aii.adapter.odata.app</display-name>
	<vendor-name>sap.com</vendor-name>
	<eis-type>ODataAdapter</eis-type>
	<resourceadapter-version>7.10</resourceadapter-version>
	<resourceadapter>
		<resourceadapter-class>com.sap.aii.adapter.odata.ra.xi.jca.ODataAdapter</resourceadapter-class>
		<outbound-resourceadapter>
			<connection-definition>
				<managedconnectionfactory-class>com.sap.aii.adapter.odata.ra.xi.jca.SPIManagedConnectionFactory</managedconnectionfactory-class>
				<connectionfactory-interface>javax.resource.cci.ConnectionFactory</connectionfactory-interface>
				<connectionfactory-impl-class>com.sap.aii.adapter.odata.ra.xi.jca.CCIConnectionFactory</connectionfactory-impl-class>
				<connection-interface>javax.resource.cci.Connection</connection-interface>
				<connection-impl-class>com.sap.aii.adapter.odata.ra.xi.jca.CCIConnection</connection-impl-class>
			</connection-definition>

			<transaction-support>NoTransaction</transaction-support>

			<authentication-mechanism>
				<authentication-mechanism-type>BasicPassword</authentication-mechanism-type>
				<credential-interface>javax.resource.spi.security.PasswordCredential</credential-interface>
			</authentication-mechanism>
			<reauthentication-support>false</reauthentication-support>
		</outbound-resourceadapter>
	</resourceadapter>
</connector>
