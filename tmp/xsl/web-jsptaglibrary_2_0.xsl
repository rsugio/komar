<?xml version="1.0" encoding="UTF-8"?><!--Author Violeta Georgieva--><xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://java.sun.com/xml/ns/j2ee">	<xsl:output method="xml" encoding="UTF-8" indent="yes"/>	<xsl:template match="*">		<taglib>			<xsl:attribute name="xsi:schemaLocation">http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-jsptaglibrary_2_0.xsd</xsl:attribute>			<xsl:attribute name="version">2.0</xsl:attribute>			<xsl:variable name="V1" select="local-name(.)"/>			<xsl:variable name="V2" select="'ABCDEFGHIJKLMNOPQRSTUVWXYZ'"/>			<xsl:variable name="V3" select="'abcdefghijklmnopqrstuvwxyz'"/>			<xsl:for-each select="*[(local-name()='description' or local-name()='info') and .!='']">				<description>					<xsl:value-of select="."/>				</description>			</xsl:for-each>			<xsl:for-each select="*[local-name()='display-name' and .!='']">				<display-name>					<xsl:value-of select="."/>				</display-name>			</xsl:for-each>			<xsl:for-each select="*[local-name()='icon' and .!='']">				<icon>					<xsl:for-each select="*[local-name()='small-icon' and .!='']">					<small-icon>						<xsl:value-of select="."/>					</small-icon>					</xsl:for-each>					<xsl:for-each select="*[local-name()='large-icon' and .!='']">					<large-icon>						<xsl:value-of select="."/>					</large-icon>					</xsl:for-each>				</icon>			</xsl:for-each>			<xsl:for-each select="*[(local-name()='tlib-version' or local-name()='tlibversion') and .!='']">				<tlib-version>					<xsl:value-of select="substring(.,1,3)"/>				</tlib-version>			</xsl:for-each>			<short-name>				<xsl:for-each select="*[(local-name()='short-name' or local-name()='shortname') and .!='']">									<xsl:value-of select="."/>				</xsl:for-each>			</short-name>			<xsl:for-each select="*[local-name()='uri' and .!='']">				<uri>					<xsl:value-of select="."/>				</uri>			</xsl:for-each>			<xsl:for-each select="*[local-name()='validator']">				<validator>					<xsl:for-each select="*[local-name()='description' and .!='']">						<description>							<xsl:value-of select="."/>						</description>					</xsl:for-each>					<xsl:for-each select="*[local-name()='validator-class' and .!='']">						<validator-class>							<xsl:value-of select="."/>						</validator-class>					</xsl:for-each>					<xsl:for-each select="*[local-name()='init-param']">						<init-param>							<xsl:for-each select="*[local-name()='description' and .!='']">								<description>									<xsl:value-of select="."/>								</description>							</xsl:for-each>							<xsl:for-each select="*[local-name()='param-name' and .!='']">								<param-name>									<xsl:value-of select="."/>								</param-name>							</xsl:for-each>							<xsl:for-each select="*[local-name()='param-value' and .!='']">								<param-value>									<xsl:value-of select="."/>								</param-value>							</xsl:for-each>						</init-param>					</xsl:for-each>				</validator>			</xsl:for-each>			<xsl:for-each select="*[local-name()='listener']">				<listener>					<xsl:for-each select="*[local-name()='listener-class' and .!='']">						<listener-class>							<xsl:value-of select="."/>						</listener-class>					</xsl:for-each>				</listener>			</xsl:for-each>			<xsl:for-each select="*[local-name()='tag']">				<tag>					<xsl:for-each select="*[(local-name()='description' or local-name()='info') and .!='']">						<description>							<xsl:value-of select="."/>						</description>					</xsl:for-each>					<xsl:for-each select="*[local-name()='display-name' and .!='']">						<display-name>							<xsl:value-of select="."/>						</display-name>					</xsl:for-each>					<icon>						<xsl:for-each select="*[local-name()='small-icon' and .!='']">							<small-icon>								<xsl:value-of select="."/>							</small-icon>						</xsl:for-each>						<xsl:for-each select="*[local-name()='large-icon' and .!='']">							<large-icon>								<xsl:value-of select="."/>							</large-icon>						</xsl:for-each>					</icon>					<xsl:for-each select="*[local-name()='name' and .!='']">						<name>							<xsl:value-of select="."/>						</name>					</xsl:for-each>					<xsl:for-each select="*[(local-name()='tag-class' or local-name()='tagclass') and .!='']">						<tag-class>							<xsl:value-of select="."/>						</tag-class>					</xsl:for-each>					<xsl:for-each select="*[(local-name()='tei-class' or local-name()='teiclass') and .!='']">						<tei-class>							<xsl:value-of select="."/>						</tei-class>					</xsl:for-each>					<xsl:choose>						<xsl:when test="count(*[local-name()='bodycontent']) != 0 or count(*[local-name()='body-content']) != 0">							<xsl:for-each select="*[(local-name()='body-content' or local-name()='bodycontent') and .!='']">								<body-content>									<xsl:if test="string-length(.) = 3">										<xsl:value-of select="translate(.,$V3,$V2)"/>									</xsl:if>									<xsl:if test="string-length(.) != 3">										<xsl:value-of select="translate(.,$V2,$V3)"/>									</xsl:if>								</body-content>															</xsl:for-each>						</xsl:when>						<xsl:otherwise>							<body-content>JSP</body-content>						</xsl:otherwise>					</xsl:choose>					<xsl:for-each select="*[local-name()='variable']">						<variable>							<xsl:for-each select="*[local-name()='description' and .!='']">								<description>									<xsl:value-of select="."/>								</description>							</xsl:for-each>							<xsl:for-each select="*[local-name()='name-given' and .!='']">								<name-given>									<xsl:value-of select="."/>								</name-given>							</xsl:for-each>							<xsl:for-each select="*[local-name()='name-from-attribute' and .!='']">								<name-from-attribute>									<xsl:value-of select="."/>								</name-from-attribute>							</xsl:for-each>							<xsl:for-each select="*[local-name()='variable-class' and .!='']">								<variable-class>									<xsl:value-of select="."/>								</variable-class>							</xsl:for-each>							<xsl:for-each select="*[local-name()='declare' and .!='']">								<declare>									<xsl:value-of select="."/>								</declare>							</xsl:for-each>							<xsl:for-each select="*[local-name()='scope' and .!='']">								<scope>									<xsl:value-of select="translate(.,$V3,$V2)"/>								</scope>							</xsl:for-each>						</variable>					</xsl:for-each>					<xsl:for-each select="*[local-name()='attribute']">						<attribute>							<xsl:for-each select="*[local-name()='description' and .!='']">								<description>									<xsl:value-of select="."/>								</description>							</xsl:for-each>							<xsl:for-each select="*[local-name()='name' and .!='']">								<name>									<xsl:value-of select="."/>								</name>							</xsl:for-each>							<xsl:for-each select="*[local-name()='required' and .!='']">								<required>									<xsl:value-of select="."/>								</required>							</xsl:for-each>							<xsl:for-each select="*[local-name()='rtexprvalue' and .!='']">								<rtexprvalue>									<xsl:value-of select="."/>								</rtexprvalue>							</xsl:for-each>							<xsl:for-each select="*[local-name()='type' and .!='']">								<type>									<xsl:value-of select="."/>								</type>							</xsl:for-each>						</attribute>					</xsl:for-each>					<xsl:for-each select="*[local-name()='example' and .!='']">						<example>							<xsl:value-of select="."/>						</example>					</xsl:for-each>				</tag>			</xsl:for-each>		</taglib>	</xsl:template></xsl:stylesheet>