<?xml version="1.0" encoding="UTF-8"?><!--Author Violeta Georgieva--><xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">	<xsl:output indent="yes" method="xml" encoding="UTF-8"/>	<xsl:template match="/web-j2ee-engine">		<web-j2ee-engine>			<xsl:attribute name="xsi:noNamespaceSchemaLocation">web-j2ee-engine.xsd</xsl:attribute>			<xsl:variable name="V1" select="."/>			<xsl:variable name="V2" select="'ABCDEFGHIJKLMNOPQRSTUVWXYZ'"/>			<xsl:variable name="V3" select="'abcdefghijklmnopqrstuvwxyz'"/>			<xsl:for-each select="spec-version[.!='']">				<spec-version>					<xsl:value-of select="."/>				</spec-version>			</xsl:for-each>			<xsl:for-each select="resource-ref[.!='']">				<resource-ref>					<xsl:choose>						<xsl:when test="count(./res-ref-name)=0">							<res-ref-name>unknown</res-ref-name>						</xsl:when>						<xsl:otherwise>							<xsl:for-each select="res-ref-name">								<res-ref-name>									<xsl:value-of select="."/>								</res-ref-name>							</xsl:for-each>						</xsl:otherwise>					</xsl:choose>					<xsl:for-each select="res-link[.!='']">						<res-link>							<xsl:value-of select="."/>						</res-link>					</xsl:for-each>					<xsl:for-each select="non-transactional">						<non-transactional/>					</xsl:for-each>				</resource-ref>			</xsl:for-each>			<xsl:for-each select="resource-env-ref[.!='']">				<xsl:choose>					<xsl:when test="count(./resource-env-ref-name)!=0 and count(./jndi-name)!=0">						<resource-env-ref>							<xsl:for-each select="resource-env-ref-name">								<resource-env-ref-name>									<xsl:value-of select="."/>								</resource-env-ref-name>							</xsl:for-each>							<xsl:for-each select="jndi-name">								<jndi-name>									<xsl:value-of select="."/>								</jndi-name>							</xsl:for-each>						</resource-env-ref>					</xsl:when>				</xsl:choose>			</xsl:for-each>			<xsl:for-each select="ejb-ref[.!='']">				<xsl:choose>					<xsl:when test="count(./ejb-ref-name)!=0 and count(./jndi-name)!=0">						<ejb-ref>							<xsl:for-each select="ejb-ref-name">								<ejb-ref-name>									<xsl:value-of select="."/>								</ejb-ref-name>							</xsl:for-each>							<xsl:for-each select="jndi-name">								<jndi-name>									<xsl:value-of select="."/>								</jndi-name>							</xsl:for-each>						</ejb-ref>					</xsl:when>				</xsl:choose>			</xsl:for-each>			<xsl:for-each select="ejb-local-ref[.!='']">				<xsl:choose>					<xsl:when test="count(./ejb-ref-name)!=0 and count(./jndi-name)!=0">						<ejb-local-ref>							<xsl:for-each select="ejb-ref-name">								<ejb-ref-name>									<xsl:value-of select="."/>								</ejb-ref-name>							</xsl:for-each>							<xsl:for-each select="jndi-name">								<jndi-name>									<xsl:value-of select="."/>								</jndi-name>							</xsl:for-each>						</ejb-local-ref>					</xsl:when>				</xsl:choose>			</xsl:for-each>			<xsl:for-each select="server-component-ref[.!='']">				<xsl:choose>					<xsl:when test="count(./name)!=0 and count(./jndi-name)!=0">						<server-component-ref>							<xsl:for-each select="description[.!='']">								<description>									<xsl:value-of select="."/>								</description>							</xsl:for-each>							<xsl:for-each select="name">								<name>									<xsl:value-of select="."/>								</name>							</xsl:for-each>							<xsl:choose>								<xsl:when test="count(./type)=0">									<type>SERVICE</type>								</xsl:when>								<xsl:otherwise>									<xsl:for-each select="type">										<type>											<xsl:value-of select="translate(.,$V3,$V2)"/>										</type>									</xsl:for-each>								</xsl:otherwise>							</xsl:choose>							<xsl:for-each select="jndi-name">								<jndi-name>									<xsl:value-of select="."/>								</jndi-name>							</xsl:for-each>						</server-component-ref>					</xsl:when>				</xsl:choose>			</xsl:for-each>			<xsl:for-each select="security-role-map[.!='']">				<xsl:choose>					<xsl:when test="count(./role-name)!=0 and count(./server-role-name)!=0">						<security-role-map>							<xsl:for-each select="role-name">								<role-name>									<xsl:value-of select="."/>								</role-name>							</xsl:for-each>							<xsl:for-each select="server-role-name">								<server-role-name>									<xsl:value-of select="."/>								</server-role-name>							</xsl:for-each>						</security-role-map>					</xsl:when>				</xsl:choose>			</xsl:for-each>			<xsl:for-each select="security-role[.!='']">				<xsl:choose>					<xsl:when test="count(./role-name)!=0 and count(./server-role-name)!=0">						<security-role-map>							<xsl:for-each select="role-name">								<role-name>									<xsl:value-of select="."/>								</role-name>							</xsl:for-each>							<xsl:for-each select="server-role-name">								<server-role-name>									<xsl:value-of select="."/>								</server-role-name>							</xsl:for-each>						</security-role-map>					</xsl:when>				</xsl:choose>			</xsl:for-each>			<xsl:for-each select="response-status[.!='']">				<xsl:choose>					<xsl:when test="(count(./code)!=0 and count(./description)!=0) or (count(./status-code)!=0 and count(./reason-phrase)!=0)">						<response-status>							<xsl:for-each select="code|status-code">								<status-code>									<xsl:value-of select="."/>								</status-code>							</xsl:for-each>							<xsl:for-each select="description|reason-phrase">								<reason-phrase>									<xsl:value-of select="."/>								</reason-phrase>							</xsl:for-each>						</response-status>					</xsl:when>				</xsl:choose>			</xsl:for-each>			<xsl:for-each select="fail-over-alert[.!='']">				<fail-over-alert>					<xsl:for-each select="message[.!='']">						<message>							<xsl:value-of select="."/>						</message>					</xsl:for-each>					<xsl:for-each select="message-timeout[.!='']">						<timeout>							<xsl:value-of select="."/>						</timeout>					</xsl:for-each>				</fail-over-alert>			</xsl:for-each>			<xsl:choose>				<xsl:when test="count(login-module-configuration) != 0">					<xsl:for-each select="login-module-configuration[.!='']">						<login-module-configuration>							<xsl:for-each select="login-module-stack[.!='']">								<login-module-stack>									<xsl:for-each select="login-module">										<xsl:choose>											<xsl:when test="count(./login-module-name)!=0 and count(./flag)!=0">												<login-module>													<xsl:for-each select="login-module-name">														<login-module-name>															<xsl:value-of select="."/>														</login-module-name>													</xsl:for-each>													<xsl:for-each select="flag">														<flag>															<xsl:value-of select="translate(.,$V3,$V2)"/>														</flag>													</xsl:for-each>													<xsl:for-each select="options[.!='']">														<options>															<xsl:for-each select="option">																<xsl:choose>																	<xsl:when test="count(./name)!=0 and count(./value)!=0">																		<option>																			<xsl:for-each select="name">																				<name>																					<xsl:value-of select="."/>																				</name>																			</xsl:for-each>																			<xsl:for-each select="value">																				<value>																					<xsl:value-of select="."/>																				</value>																			</xsl:for-each>																		</option>																	</xsl:when>																</xsl:choose>															</xsl:for-each>														</options>													</xsl:for-each>												</login-module>											</xsl:when>										</xsl:choose>									</xsl:for-each>								</login-module-stack>							</xsl:for-each>							<xsl:for-each select="password-change-config[.!='']">								<password-change-config>									<xsl:choose>										<xsl:when test="count(./login-page)=0 and count(./error-page)!=0">											<xsl:for-each select="error-page">												<login-page>													<xsl:value-of select="."/>												</login-page>											</xsl:for-each>										</xsl:when>										<xsl:otherwise>											<xsl:for-each select="login-page">												<login-page>													<xsl:value-of select="."/>												</login-page>											</xsl:for-each>										</xsl:otherwise>									</xsl:choose>									<xsl:choose>										<xsl:when test="count(./error-page)=0 and count(./login-page)!=0">											<xsl:for-each select="login-page">												<error-page>													<xsl:value-of select="."/>												</error-page>											</xsl:for-each>										</xsl:when>										<xsl:otherwise>											<xsl:for-each select="error-page">												<error-page>													<xsl:value-of select="."/>												</error-page>											</xsl:for-each>										</xsl:otherwise>									</xsl:choose>								</password-change-config>							</xsl:for-each>							<xsl:for-each select="$V1/security-policy-domain[.!='']">								<security-policy-domain>									<xsl:value-of select="."/>								</security-policy-domain>							</xsl:for-each>						</login-module-configuration>					</xsl:for-each>				</xsl:when>				<xsl:otherwise>					<xsl:for-each select="$V1/security-policy-domain[.!='']">            <login-module-configuration>							<security-policy-domain>								<xsl:value-of select="."/>							</security-policy-domain>            </login-module-configuration>					</xsl:for-each>				</xsl:otherwise>			</xsl:choose>			<xsl:for-each select="url-session-tracking">				<url-session-tracking>true</url-session-tracking>			</xsl:for-each>			<xsl:for-each select="max-sessions[.!='']">				<max-sessions>					<xsl:value-of select="."/>				</max-sessions>			</xsl:for-each>			<xsl:for-each select="cookie-config[.!='']">				<cookie-config>					<xsl:for-each select="cookie">						<cookie>							<xsl:for-each select="type">								<type>									<xsl:value-of select="translate(.,$V3,$V2)"/>								</type>							</xsl:for-each>							<xsl:for-each select="path">								<path>									<xsl:value-of select="."/>								</path>							</xsl:for-each>							<xsl:for-each select="domain">								<domain>									<xsl:value-of select="."/>								</domain>							</xsl:for-each>							<xsl:for-each select="max-age">								<max-age>									<xsl:value-of select="."/>								</max-age>							</xsl:for-each>						</cookie>					</xsl:for-each>				</cookie-config>			</xsl:for-each>			<xsl:for-each select="get-request-url-mode[.!='']">				<get-request-url-mode>					<xsl:value-of select="."/>				</get-request-url-mode>			</xsl:for-each>		</web-j2ee-engine>	</xsl:template></xsl:stylesheet>