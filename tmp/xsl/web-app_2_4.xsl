<?xml version="1.0" encoding="UTF-8"?><!--Author Violeta Georgieva--><xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://java.sun.com/xml/ns/j2ee">	<xsl:output indent="yes" method="xml" encoding="UTF-8"/>	<xsl:template match="/web-app">		<web-app>			<xsl:attribute name="xsi:schemaLocation">http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-app_2_4.xsd</xsl:attribute>			<xsl:attribute name="version">2.4</xsl:attribute>			<xsl:for-each select="description[.!='']">				<description>					<xsl:value-of select="."/>				</description>			</xsl:for-each>			<xsl:for-each select="display-name[.!='']">				<display-name>					<xsl:value-of select="."/>				</display-name>			</xsl:for-each>			<xsl:for-each select="icon[.!='']">				<icon>					<xsl:for-each select="small-icon[.!='']">						<small-icon>							<xsl:value-of select="."/>						</small-icon>					</xsl:for-each>					<xsl:for-each select="large-icon[.!='']">						<large-icon>							<xsl:value-of select="."/>						</large-icon>					</xsl:for-each>				</icon>			</xsl:for-each>			<xsl:for-each select="distributable">				<distributable/>			</xsl:for-each>			<xsl:for-each select="context-param[.!='']">				<xsl:choose>					<xsl:when test="count(./param-name)!=0 and count(./param-value)!=0">						<context-param>							<xsl:for-each select="description[.!='']">								<description>									<xsl:value-of select="."/>								</description>							</xsl:for-each>							<xsl:if test="param-name">								<param-name>									<xsl:value-of select="param-name[last()]"/>								</param-name>							</xsl:if>							<xsl:if test="param-value">								<param-value>									<xsl:value-of select="param-value[last()]"/>								</param-value>							</xsl:if>						</context-param>					</xsl:when>				</xsl:choose>			</xsl:for-each>			<xsl:for-each select="filter[.!='']">				<xsl:choose>					<xsl:when test="count(./filter-name)!=0 and count(./filter-class)!=0">						<filter>							<xsl:for-each select="description[.!='']">								<description>									<xsl:value-of select="."/>								</description>							</xsl:for-each>							<xsl:for-each select="display-name[.!='']">								<display-name>									<xsl:value-of select="."/>								</display-name>							</xsl:for-each>							<xsl:for-each select="icon[.!='']">								<icon>									<xsl:for-each select="small-icon[.!='']">										<small-icon>											<xsl:value-of select="."/>										</small-icon>									</xsl:for-each>									<xsl:for-each select="large-icon[.!='']">										<large-icon>											<xsl:value-of select="."/>										</large-icon>									</xsl:for-each>								</icon>							</xsl:for-each>							<xsl:for-each select="filter-name">								<filter-name>									<xsl:value-of select="."/>								</filter-name>							</xsl:for-each>							<xsl:for-each select="filter-class">								<filter-class>									<xsl:value-of select="."/>								</filter-class>							</xsl:for-each>							<xsl:for-each select="init-param[.!='']">								<xsl:choose>									<xsl:when test="count(./param-name)!=0 and count(./param-value)!=0">										<init-param>											<xsl:for-each select="description[.!='']">												<description>													<xsl:value-of select="."/>												</description>											</xsl:for-each>											<xsl:if test="param-name">												<param-name>													<xsl:value-of select="param-name[last()]"/>												</param-name>											</xsl:if>											<xsl:if test="param-value">												<param-value>													<xsl:value-of select="param-value[last()]"/>												</param-value>											</xsl:if>										</init-param>									</xsl:when>								</xsl:choose>							</xsl:for-each>						</filter>					</xsl:when>				</xsl:choose>			</xsl:for-each>			<xsl:for-each select="filter-mapping[.!='']">				<xsl:choose>					<xsl:when test="count(./filter-name)!=0 and (count(./url-pattern)!=0 or count(./servlet-name)!=0)">						<filter-mapping>							<xsl:for-each select="filter-name">								<filter-name>									<xsl:value-of select="."/>								</filter-name>							</xsl:for-each>							<xsl:for-each select="url-pattern">								<xsl:choose>									<xsl:when test=". = '*'">										<xsl:comment>'*' is not a valid value for url-pattern element, because of this it is transformed to '/*'</xsl:comment>										<url-pattern>/*</url-pattern>									</xsl:when>									<xsl:otherwise>										<url-pattern>											<xsl:value-of select="."/>										</url-pattern>									</xsl:otherwise>								</xsl:choose>							</xsl:for-each>							<xsl:for-each select="servlet-name">								<servlet-name>									<xsl:value-of select="."/>								</servlet-name>							</xsl:for-each>						</filter-mapping>					</xsl:when>				</xsl:choose>			</xsl:for-each>			<xsl:for-each select="listener[.!='']">				<xsl:choose>					<xsl:when test="count(./listener-class)!=0">						<listener>							<xsl:for-each select="listener-class">								<listener-class>									<xsl:value-of select="."/>								</listener-class>							</xsl:for-each>						</listener>					</xsl:when>				</xsl:choose>			</xsl:for-each>			<xsl:for-each select="servlet[.!='']">				<xsl:choose>					<xsl:when test="count(./servlet-name)!=0 and (count(./servlet-class)!=0 or count(./jsp-file)!=0)">						<servlet>							<xsl:for-each select="description[.!='']">								<description>									<xsl:value-of select="."/>								</description>							</xsl:for-each>							<xsl:for-each select="display-name[.!='']">								<display-name>									<xsl:value-of select="."/>								</display-name>							</xsl:for-each>							<xsl:for-each select="icon[.!='']">								<icon>									<xsl:for-each select="small-icon[.!='']">										<small-icon>											<xsl:value-of select="."/>										</small-icon>									</xsl:for-each>									<xsl:for-each select="large-icon[.!='']">										<large-icon>											<xsl:value-of select="."/>										</large-icon>									</xsl:for-each>								</icon>							</xsl:for-each>							<xsl:for-each select="servlet-name">								<servlet-name>									<xsl:value-of select="."/>								</servlet-name>							</xsl:for-each>							<xsl:for-each select="servlet-class">								<servlet-class>									<xsl:value-of select="."/>								</servlet-class>							</xsl:for-each>							<xsl:for-each select="jsp-file">								<jsp-file>									<xsl:value-of select="."/>								</jsp-file>							</xsl:for-each>							<xsl:for-each select="init-param[.!='']">								<xsl:choose>									<xsl:when test="count(./param-name)!=0 and count(./param-value)!=0">										<init-param>											<xsl:for-each select="description[.!='']">												<description>													<xsl:value-of select="."/>												</description>											</xsl:for-each>											<xsl:if test="param-name">												<param-name>													<xsl:value-of select="param-name[last()]"/>												</param-name>											</xsl:if>											<xsl:if test="param-value">												<param-value>													<xsl:value-of select="param-value[last()]"/>												</param-value>											</xsl:if>										</init-param>									</xsl:when>								</xsl:choose>							</xsl:for-each>							<xsl:for-each select="load-on-startup[.!='']">								<load-on-startup>									<xsl:value-of select="."/>								</load-on-startup>							</xsl:for-each>							<xsl:for-each select="run-as[.!='']">								<run-as>									<xsl:for-each select="description[.!='']">										<description>											<xsl:value-of select="."/>										</description>									</xsl:for-each>									<xsl:choose>										<xsl:when test="count(./role-name)=0">											<role-name>test</role-name>										</xsl:when>										<xsl:otherwise>											<xsl:for-each select="role-name">												<role-name>													<xsl:value-of select="."/>												</role-name>											</xsl:for-each>										</xsl:otherwise>									</xsl:choose>								</run-as>							</xsl:for-each>							<xsl:for-each select="security-role-ref[.!='']">								<xsl:choose>									<xsl:when test="count(./role-name)!=0">										<security-role-ref>											<xsl:for-each select="description[.!='']">												<description>													<xsl:value-of select="."/>												</description>											</xsl:for-each>											<xsl:for-each select="role-name">												<role-name>													<xsl:value-of select="."/>												</role-name>											</xsl:for-each>											<xsl:for-each select="role-link[.!='']">												<role-link>													<xsl:value-of select="."/>												</role-link>											</xsl:for-each>										</security-role-ref>									</xsl:when>								</xsl:choose>							</xsl:for-each>						</servlet>					</xsl:when>				</xsl:choose>			</xsl:for-each>			<xsl:for-each select="servlet-mapping[.!='']">				<xsl:choose>					<xsl:when test="count(./servlet-name)!=0 and count(./url-pattern)!=0">						<servlet-mapping>							<xsl:for-each select="servlet-name">								<servlet-name>									<xsl:value-of select="."/>								</servlet-name>							</xsl:for-each>							<xsl:for-each select="url-pattern">								<xsl:choose>									<xsl:when test=". = '*'">										<xsl:comment>'*' is not a valid value for url-pattern element, because of this it is transformed to '/*'</xsl:comment>										<url-pattern>/*</url-pattern>									</xsl:when>									<xsl:otherwise>										<url-pattern>											<xsl:value-of select="."/>										</url-pattern>									</xsl:otherwise>								</xsl:choose>							</xsl:for-each>						</servlet-mapping>					</xsl:when>				</xsl:choose>			</xsl:for-each>			<xsl:if test="count(session-config) > 0">				<xsl:if test="count(session-config[last()]/session-timeout) > 0">					<session-config>						<session-timeout>							<xsl:value-of select="session-config[last()]/session-timeout[last()]"/>						</session-timeout>					</session-config>				</xsl:if>			</xsl:if>			<xsl:for-each select="mime-mapping[.!='']">				<xsl:choose>					<xsl:when test="count(./extension)!=0 and count(./mime-type)!=0">						<mime-mapping>							<xsl:for-each select="extension">								<extension>									<xsl:value-of select="."/>								</extension>							</xsl:for-each>							<xsl:for-each select="mime-type">								<mime-type>									<xsl:value-of select="."/>								</mime-type>							</xsl:for-each>						</mime-mapping>					</xsl:when>				</xsl:choose>			</xsl:for-each>			<xsl:for-each select="welcome-file-list[.!='']">				<xsl:choose>					<xsl:when test="count(./welcome-file)!=0">						<welcome-file-list>							<xsl:for-each select="welcome-file">								<welcome-file>									<xsl:value-of select="."/>								</welcome-file>							</xsl:for-each>						</welcome-file-list>					</xsl:when>				</xsl:choose>			</xsl:for-each>			<xsl:for-each select="error-page[.!='']">				<xsl:choose>					<xsl:when test="(count(./error-code)!=0 or count(./exception-type)!=0) and count(./location)!=0">						<error-page>							<xsl:for-each select="error-code">								<error-code>									<xsl:value-of select="."/>								</error-code>							</xsl:for-each>							<xsl:for-each select="exception-type">								<exception-type>									<xsl:value-of select="."/>								</exception-type>							</xsl:for-each>							<xsl:for-each select="location">								<xsl:choose>									<xsl:when test="not(starts-with(.,'/'))">										<location>											/<xsl:value-of select="."/>										</location>									</xsl:when>									<xsl:otherwise>										<location>											<xsl:value-of select="."/>										</location>									</xsl:otherwise>								</xsl:choose>							</xsl:for-each>						</error-page>					</xsl:when>				</xsl:choose>			</xsl:for-each>			<xsl:if test="count(taglib) > 0">				<jsp-config>					<xsl:for-each select="taglib[.!='']">						<xsl:choose>							<xsl:when test="count(./taglib-uri)!=0 and count(./taglib-location)!=0">								<taglib>									<xsl:for-each select="taglib-uri">										<taglib-uri>											<xsl:value-of select="."/>										</taglib-uri>									</xsl:for-each>									<xsl:for-each select="taglib-location">										<taglib-location>											<xsl:value-of select="."/>										</taglib-location>									</xsl:for-each>								</taglib>							</xsl:when>						</xsl:choose>					</xsl:for-each>				</jsp-config>			</xsl:if>			<xsl:for-each select="security-constraint[.!='']">				<security-constraint>					<xsl:for-each select="display-name[.!='']">						<display-name>							<xsl:value-of select="."/>						</display-name>					</xsl:for-each>					<xsl:for-each select="web-resource-collection[.!='']">						<web-resource-collection>							<xsl:choose>								<xsl:when test="count(./web-resource-name) = 0">									<web-resource-name>unknown</web-resource-name>								</xsl:when>								<xsl:otherwise>									<xsl:for-each select="web-resource-name">										<web-resource-name>											<xsl:value-of select="."/>										</web-resource-name>									</xsl:for-each>								</xsl:otherwise>							</xsl:choose>							<xsl:for-each select="description[.!='']">								<description>									<xsl:value-of select="."/>								</description>							</xsl:for-each>							<xsl:choose>								<xsl:when test="count(./url-pattern) = 0">									<url-pattern>/ERROR_IN_web-resource-collection_THERE_IS_NOT_url-pattern</url-pattern>								</xsl:when>								<xsl:otherwise>									<xsl:for-each select="url-pattern">										<xsl:choose>											<xsl:when test=". = '*'">												<xsl:comment>'*' is not a valid value for url-pattern element, because of this it is transformed to '/*'</xsl:comment>												<url-pattern>/*</url-pattern>											</xsl:when>											<xsl:otherwise>												<url-pattern>													<xsl:value-of select="."/>												</url-pattern>											</xsl:otherwise>										</xsl:choose>									</xsl:for-each>								</xsl:otherwise>							</xsl:choose>							<xsl:for-each select="http-method[.!='']">								<http-method>									<xsl:value-of select="."/>								</http-method>							</xsl:for-each>						</web-resource-collection>					</xsl:for-each>					<xsl:choose>						<xsl:when test="count(auth-constraint) > 1">							<auth-constraint>								<xsl:if test="count(./auth-constraint[last()]/description) > 0">									<description>										<xsl:value-of select="./auth-constraint[last()]/description[last()]"/>									</description>								</xsl:if>								<xsl:for-each select="./auth-constraint[last()]/role-name[.!='']">									<role-name>										<xsl:value-of select="."/>									</role-name>								</xsl:for-each>							</auth-constraint>						</xsl:when>						<xsl:otherwise>							<xsl:for-each select="auth-constraint">								<auth-constraint>									<xsl:for-each select="description[.!='']">										<description>											<xsl:value-of select="."/>										</description>									</xsl:for-each>									<xsl:for-each select="role-name[.!='']">										<role-name>											<xsl:value-of select="."/>										</role-name>									</xsl:for-each>								</auth-constraint>							</xsl:for-each>						</xsl:otherwise>					</xsl:choose>					<xsl:for-each select="user-data-constraint[.!='']">						<xsl:choose>							<xsl:when test="count(./transport-guarantee)!=0">								<user-data-constraint>									<xsl:for-each select="description[.!='']">										<description>											<xsl:value-of select="."/>										</description>									</xsl:for-each>									<xsl:f