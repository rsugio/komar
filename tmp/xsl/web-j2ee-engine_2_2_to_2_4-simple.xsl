<?xml version="1.0" encoding="UTF-8"?><!--Author Violeta Georgieva--><xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">	<xsl:output indent="yes" method="xml" encoding="UTF-8"/>	<xsl:template match="/web-app">		<web-j2ee-engine>			<xsl:attribute name="xsi:noNamespaceSchemaLocation">web-j2ee-engine.xsd</xsl:attribute>			<xsl:variable name="V2" select="'ABCDEFGHIJKLMNOPQRSTUVWXYZ'"/>			<xsl:variable name="V3" select="'abcdefghijklmnopqrstuvwxyz'"/>			<xsl:for-each select="spec-version[.!='']">				<spec-version>					<xsl:value-of select="."/>				</spec-version>			</xsl:for-each>			<xsl:for-each select="resource-ref[.!='']">				<resource-ref>					<xsl:for-each select="res-ref-name">						<res-ref-name>							<xsl:value-of select="."/>						</res-ref-name>					</xsl:for-each>					<xsl:for-each select="res-link[.!='']">						<res-link>							<xsl:value-of select="."/>						</res-link>					</xsl:for-each>				</resource-ref>			</xsl:for-each>			<xsl:for-each select="security-role[.!='']">				<xsl:choose>					<xsl:when test="count(./role-name)!=0 and (count(./user-name)!=0 or count(./group-name)!=0)">						<security-role-map>							<xsl:for-each select="role-name">								<role-name>									<xsl:value-of select="."/>								</role-name>							</xsl:for-each>							<xsl:for-each select="user-name[.!='']">								<user-name>									<xsl:value-of select="."/>								</user-name>							</xsl:for-each>							<xsl:for-each select="group-name[.!='']">								<group-name>									<xsl:value-of select="."/>								</group-name>							</xsl:for-each>						</security-role-map>					</xsl:when>				</xsl:choose>			</xsl:for-each>			<xsl:for-each select="response-status[.!='']">				<response-status>					<xsl:for-each select="code">						<status-code>							<xsl:value-of select="."/>						</status-code>					</xsl:for-each>					<xsl:for-each select="description">						<reason-phrase>							<xsl:value-of select="."/>						</reason-phrase>					</xsl:for-each>				</response-status>			</xsl:for-each>			<xsl:for-each select="max-sessions[.!='']">				<max-sessions>					<xsl:value-of select="."/>				</max-sessions>			</xsl:for-each>			<xsl:for-each select="cookie-config[.!='']">				<cookie-config>					<xsl:for-each select="cookie">						<cookie>							<xsl:for-each select="type">								<type>									<xsl:value-of select="translate(.,$V3,$V2)"/>								</type>							</xsl:for-each>							<xsl:for-each select="path">								<path>									<xsl:value-of select="."/>								</path>							</xsl:for-each>							<xsl:for-each select="domain">								<domain>									<xsl:value-of select="."/>								</domain>							</xsl:for-each>						</cookie>					</xsl:for-each>				</cookie-config>			</xsl:for-each>		</web-j2ee-engine>	</xsl:template></xsl:stylesheet>